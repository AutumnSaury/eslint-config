{
  "name": "@akisaira/eslint-config",
  "version": "0.0.4",
  "description": "Personal ESLint configuration",
  "main": "dist/index.js",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "inspect": "npx @eslint/config-inspector",
    "test": "eslint",
    "lint": "eslint --fix"
  },
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "author": {
